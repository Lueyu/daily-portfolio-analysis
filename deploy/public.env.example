# Copy to an untracked .env.production in the repository root.
# Generate three independent random values; never reuse the example placeholders.
POSTGRES_PASSWORD=replace-with-long-random-alphanumeric-password
JWT_SECRET=replace-with-independent-long-random-secret
SETTINGS_ENCRYPTION_KEY=replace-with-independent-long-random-secret
# Open only while creating the first owner through a local SSH tunnel.
REGISTER_ENABLED=false
