# ===== Webapp (NestJS) =====
WEBAPP_BASE_URL=http://localhost:3000
WEBAPP_AGENT_TOKEN=dev-agent-token-change-me
WEBAPP_DEFAULT_USER_ID=local-dev

# ===== Shared models: OpenAI-compatible Chat Completions =====
MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Model connection tests and live requests share this explicit proxy policy.
# Set true only when model traffic needs HTTP(S)_PROXY / system proxies / custom CA env vars.
MODEL_TRUST_ENV=false
# Finite per-attempt model request timeout; this does not cap task iterations.
MODEL_REQUEST_TIMEOUT_SECONDS=180
FLASH_MODEL=deepseek-v4-1-flash-260910
FLASH_API_KEY=
PRO_MODEL=deepseek-v4-pro-ga-260813
PRO_API_KEY=

# ===== Runtime =====
CHECKPOINT_DIR=data/checkpoints
LOG_LEVEL=INFO

# Coder runs continuously by default. Leave these unset for no task-wide cap.
# Optional positive limits for explicitly bounded runs:
# CODER_MAX_ITERATIONS=8
# CODER_MAX_MODEL_CALLS=40
# CODER_WALLCLOCK_SECONDS=1800
# CODER_MAX_PROBES=10
# Resume an old automatic budget stop without deleting its evidence:
# agent dev run <task-id> --resume-budget

# New /dev tasks use a real container sandbox. Prepare it with:
# powershell -File scripts/coder-runtime/prepare.ps1
CODER_RUNTIME_IMAGE=coding-agent-runtime:local
# Native Docker is preferred; Windows otherwise uses Docker inside WSL Ubuntu.
# CODER_DOCKER_COMMAND=["wsl","-d","Ubuntu","--exec","docker"]
# Enable only for a provider/model that accepts image content blocks:
FLASH_SUPPORTS_IMAGES=false
PRO_SUPPORTS_IMAGES=false

# Coding profile: use the existing pro tier by default, never silently fall back.
CODER_MODEL_TIER=pro
CODER_ALLOW_FALLBACK=false
# Independent OpenAI-compatible Chat Completions endpoint, when desired:
# CODER_MODEL=your-verified-model-id
# CODER_BASE_URL=https://your-provider.example/v1
# CODER_API_KEY=
# Or reference an environment variable already supplied to the process:
# CODER_API_KEY_ENV=YOUR_CODER_KEY
# CODER_CONTEXT_WINDOW=128000
CODER_MAX_OUTPUT_TOKENS=8192
# CODER_SUPPORTS_IMAGES=false
# Separate image inspection model. Enable only after checking provider capability.
# CODER_VISION_MODEL=your-verified-vision-model-id
# CODER_VISION_BASE_URL=https://your-provider.example/v1
# CODER_VISION_API_KEY=
# CODER_VISION_API_KEY_ENV=YOUR_VISION_KEY
CODER_VISION_SUPPORTS_IMAGES=false

# Operator-owned MCP JSON config outside task workspaces; only Streamable HTTP.
# CODER_MCP_CONFIG=C:/Users/your-name/.coding-agent/mcp.json
# Format: {"servers":{"docs":{"url":"https://mcp.example/mcp",
#   "headersEnv":{"Authorization":"DOCS_MCP_AUTH"},
#   "allowedTools":["search","create_issue"],"readOnlyTools":["search"]}}}
# DOCS_MCP_AUTH is a process environment variable (including the Bearer prefix).
# Any tool not explicitly in readOnlyTools needs per-call human approval.
# Project skills are read from .agents/skills; this adds another trusted root:
# CODER_SKILLS_DIR=C:/Users/your-name/.agents/skills

CODER_NETWORK_MODE=allowlist
# JSON array; matching is exact, *.example.com explicitly permits subdomains.
# CODER_NETWORK_ALLOWED_HOSTS=["registry.npmjs.org","pypi.org","files.pythonhosted.org","react.dev"]
CODER_MAX_WORKERS=3
CODER_MAX_WORKER_DEPTH=1
CODER_CONTEXT_BYTES=192000
