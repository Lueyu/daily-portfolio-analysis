# ===== Webapp (NestJS) =====
WEBAPP_BASE_URL=http://localhost:3000
WEBAPP_AGENT_TOKEN=dev-agent-token-change-me
WEBAPP_DEFAULT_USER_ID=local-dev

# ===== Model: Volcengine Ark (Doubao), OpenAI-compatible =====
# Model is usually an endpoint id like ep-xxxx from the Ark console.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-lite-4k

# ===== Model: DeepSeek, OpenAI-compatible =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Runtime =====
CHECKPOINT_DIR=data/checkpoints
LOG_LEVEL=INFO
