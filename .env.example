# ===== Runtime =====
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# ===== Logging =====
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# ===== Optional LLM (multi-agent analysis) =====
# Leave these empty for basic analysis, or use your own provider credentials.
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_FAST=doubao-lite-4k
DOUBAO_MODEL_SLOW=doubao-pro-32k

# ===== Source development (npm run dev) =====
# The Docker and desktop modes configure their own local database and secrets.
# For source development, provide your own local PostgreSQL 16 database and a
# private JWT secret of at least 16 characters.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/portfolio
# JWT_SECRET=replace-with-your-own-long-random-value
# REGISTER_ENABLED=true
