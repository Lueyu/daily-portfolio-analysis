# ===== Runtime =====
NODE_ENV=development
SERVER_HOST=localhost
SERVER_PORT=3000

# ===== Logging =====
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# ===== LLM (Multi-Agent analysis) =====
# Get your API key from the Volcengine Ark (Doubao) console.
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_FAST=doubao-lite-4k
DOUBAO_MODEL_SLOW=doubao-pro-32k

# ===== Database =====
# When running outside the managed platform, point this at your own PostgreSQL.
# DATABASE_URL=postgresql://user:password@localhost:5432/portfolio
