# ============================================================================
# .env.local.example — local FULL-OFFLINE dev environment template
# ----------------------------------------------------------------------------
# Copy to `.env.local` (gitignored, never committed) before running the local
# dev stack:
#
#   1. powershell -ExecutionPolicy Bypass -File scripts\db\rebuild-local.ps1
#      (one-time: create the portfolio DB, workspace schema, roles and import
#      the real data snapshot from db/snapshot/*.sql)
#   2. Copy-Item .env.local.example .env.local
#   3. node scripts/dev-local.js
#   4. open http://localhost:8080
#
# Alternative: scripts/dev-local-full.ps1 sets these same variables inline
# (and auto-detects the owner id), so it does not need a .env.local at all.
# ============================================================================

# ===== Runtime =====
NODE_ENV=development
SERVER_HOST=localhost
SERVER_PORT=3000

# ===== Local PostgreSQL =====
# The scoop PostgreSQL install uses trust auth locally (the postgres user has
# no password). The `?schema=` query param is what nestjs-datapaas reads as the
# roleSchema suffix (SET LOCAL ROLE authenticated_<schema> ...).
SUDA_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/portfolio?schema=workspace_aadkwdme7deas

# ===== Local identity (bypasses the API gateway) =====
# Must be the owner id of the rows in the snapshot, otherwise row-level
# security filters everything out. Leave blank to disable (protected routes
# then return 401). Find the primary owner with:
#   psql -U postgres -h 127.0.0.1 -d portfolio -tAc \
#     "SELECT (owner).user_id FROM workspace_aadkwdme7deas.holdings GROUP BY (owner).user_id ORDER BY count(*) DESC LIMIT 1;"
LOCAL_DEV_USER_ID=
LOCAL_DEV_TENANT_ID=local-tenant

# ===== Platform HTTP client (local placeholder) =====
# PlatformHttpClientService requires a base domain at construction time; the
# real value is normally written here by `lark-cli env pull`. The core local
# stack (data + identity) does not call the platform inner API, so an unused
# placeholder is enough to pass the startup check.
FORCE_AUTHN_INNERAPI_DOMAIN=http://127.0.0.1:3001

# ===== CSRF =====
# The local Vite frontend has no gateway cookie session, so disable the
# browser CSRF double-token guard. Production keeps CSRF enabled when this is
# unset. The Python agent gateway under /openapi is unaffected either way.
DISABLE_CSRF=true
