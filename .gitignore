# ============================================================
# 项目补充：Python Agent 与本地调试文件
# ============================================================

# Miaoda skills sync 产物（本地）
.agents/

# Python Agent —— 虚拟环境 / 缓存（可重建）
agent/.venv/
agent/.pytest_cache/
agent/.ruff_cache/
__pycache__/
*.py[cod]
*.egg-info/
wheels/

# Python Agent —— 密钥与本地环境（.env.example 保留入库）
agent/.env
agent/.env.local
!agent/.env.example

# Agent 运行时数据（保留目录与 .gitkeep，忽略内容）
agent/data/checkpoints/*
!agent/data/checkpoints/.gitkeep

# 本地真实数据快照（从妙搭导出的个人持仓 *.sql，仅本地，不公开）；
# 保留目录里的 README.md，而 scripts/db/ 的建表 SQL 与启动脚本正常入库。
db/snapshot/*.sql

# 本地后端调试日志（后台 dev server 重定向产物）
/backend-*.log

# 本地设计文档（仅本地，不入库；docs/screenshots 为 README 截图，正常入库）
docs/*
!docs/screenshots/
